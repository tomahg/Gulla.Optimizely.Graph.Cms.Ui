@{
    Layout = null;
}
<p class="gulla-section__lead">
    Use pinned results, previously called best bets, to create a custom list of matching
    content for common search phrases. Pinned results are presented at the beginning of
    the search results.
</p>

@* Filled in by JS whenever the collection changes. The key is the value a developer needs for
   their GraphQL query, so it is the one shown first and given the copy button. *@
<div id="gulla-collection-info" class="gulla-info" hidden></div>

<form id="gulla-pinned-form" class="gulla-form">
    <div class="gulla-form__row">
        <label for="gulla-pinned-phrases" class="gulla-form__label">Phrases</label>
        <div class="gulla-form__field">
            <input id="gulla-pinned-phrases" type="text" class="gulla-form__input" />
            <small class="gulla-form__hint">Separate multiple phrases with comma</small>
        </div>
    </div>

    <div class="gulla-form__row">
        <label class="gulla-form__label">Target content</label>
        <div class="gulla-form__field">
            <optimizely-content-tree id="content-tree"></optimizely-content-tree>
            <input id="gulla-pinned-target" type="hidden" />
            @* Shown while editing: the component always mounts with no selection, so this is
               the only way to tell the editor which content the pinned result currently points at. *@
            <div id="gulla-pinned-target-current" class="gulla-form__hint" hidden></div>
        </div>
    </div>

    @* Graph stores language: null to mean "every locale". That is a real stored value, not a
       fan-out — one item that fires whatever language the visitor is searching in. *@
    <div class="gulla-form__row gulla-form__row--checkbox">
        <span class="gulla-form__label">All Languages</span>
        <div class="gulla-form__field">
            <input id="gulla-pinned-all-langs" type="checkbox" class="gulla-form__checkbox" />
        </div>
        <label for="gulla-pinned-all-langs" class="gulla-form__hint gulla-form__hint--inline">
            Fires regardless of the language being searched.
            Leave unchecked to pin only in <span id="gulla-pinned-lang-name">the selected language</span>.
        </label>
    </div>

    <div class="gulla-form__row">
        <label for="gulla-pinned-priority" class="gulla-form__label">Priority</label>
        <div class="gulla-form__field">
            <input id="gulla-pinned-priority" type="number" step="any" value="1" class="gulla-form__input gulla-form__input--small" />
        </div>
    </div>

    <div class="gulla-form__actions">
        <button type="submit" id="gulla-pinned-submit" class="gulla-button gulla-button--primary">Add pinned result</button>
        <button type="button" id="gulla-pinned-cancel" class="gulla-button">Cancel</button>
    </div>
</form>

<div class="gulla-list-header">
    <h2 class="gulla-list-header__title">Pinned Results</h2>
    <input type="search" id="gulla-pinned-filter" class="gulla-search" placeholder="Search" />
</div>

<div id="gulla-pinned-list" class="gulla-list">
    <div class="gulla-list__empty">There are no pinned results yet</div>
</div>
