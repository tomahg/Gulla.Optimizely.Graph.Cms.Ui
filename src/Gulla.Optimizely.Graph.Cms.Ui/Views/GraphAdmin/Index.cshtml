@using EPiServer.Framework.Web
@using EPiServer.Framework.Web.Resources
@using EPiServer.Shell.UI.WebComponents
@inject IRequiredClientResourceList RequiredResources
@model GraphAdminViewModel
@{
    Layout = null;

    // The static assets live in a version-stamped folder so an upgrade never serves a cached
    // copy of the previous release's JS. Hard-coded on purpose: the project sets
    // <GenerateAssemblyInfo>false</GenerateAssemblyInfo>, so <AssemblyVersion> is never written
    // into the assembly and reading it back here yields 0.0.0.
    // BUMP TOGETHER on every release: <Version> in the .csproj, the folder name under
    // wwwroot/Static/, module.config's version + clientResourceRelativePath, and this line.
    var assets = "/_content/Gulla.Optimizely.Graph.Cms.Ui/Static/2.0.1";

    // Optimizely's Dojo runtime and the epi-cms bundle. The content picker is the
    // <optimizely-content-tree> web component and needs neither, but the shell chrome
    // (<platform-navigation>) is rendered by scripts these bundles pull in. Shell's widgets.js
    // MUST load before CMS's — the order of Require() calls determines script emission order.
    RequiredResources.Require("epi.shell.ui");
    RequiredResources.Require("epi-cms.widgets.base");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Graph Optimization</title>
    <link rel="stylesheet" href="@assets/graph-cms-ui.css" />
    <required-client-resources area="@RenderingTags.Header" />
    @Html.Raw(Html.RegisterOptimizelyWebComponents())
</head>
<body class="gulla-graph-ui">
    @Html.AntiForgeryToken()
    @* The shell's React navigation bundle reads settings (including the antiforgery form
       field name) from this element's data-epi-common-settings attribute. Without it, axios
       skips setting the RequestVerificationToken header and background polls 400. *@
    <div id="episerver-common-settings-container"
         data-epi-common-settings='{"antiforgeryFormFieldName":"__RequestVerificationToken","antiforgeryHeaderName":"RequestVerificationToken","shellModuleUrl":"/episerver/Shell","cmsModuleUrl":"/episerver/CMS","modules":[]}'
         hidden></div>
    <platform-navigation />
    <platform-navigation-wrapper>
        <div class="gulla-toolbar">
            @* Collections hold pinned results only — the picker is populated by JS because its
               contents depend on the selected site. Hidden on the Synonyms tab. *@
            <span id="gulla-collection-picker" class="gulla-toolbar__group">
                <span class="gulla-toolbar__label">Collection</span>
                <select id="gulla-collection-select" class="gulla-toolbar__select"></select>
                <button type="button" id="gulla-collection-add" class="gulla-button gulla-button--small" title="Create a new collection for this site">New</button>
                <button type="button" id="gulla-collection-delete" class="gulla-button gulla-button--small" title="Delete this collection and all its pinned results">Delete</button>
            </span>
            @* The synonym slot is the counterpart of the collection picker: both name the thing
               a query has to reference. Shown only on the Synonyms tab. *@
            <span id="gulla-slot-picker" class="gulla-toolbar__group" hidden>
                <span class="gulla-toolbar__label">Slot</span>
                <select id="gulla-syn-slot" class="gulla-toolbar__select">
                    <option value="one">One</option>
                    <option value="two">Two</option>
                </select>
            </span>
            @* Synonyms have no per-site dimension in Graph, so the site picker is hidden
               while that tab is active rather than implying a scope that isn't there. *@
            <span id="gulla-site-picker" class="gulla-toolbar__group">
                <span class="gulla-toolbar__label">For</span>
                <select id="gulla-site-select" class="gulla-toolbar__select">
                    @foreach (var site in Model.Sites)
                    {
                        <option value="@site.Key" selected="@(site.Key == Model.SelectedSiteKey)">@site.Name</option>
                    }
                </select>
            </span>
            <span class="gulla-toolbar__label">in</span>
            <select id="gulla-lang-select" class="gulla-toolbar__select">
                @foreach (var lang in Model.Languages)
                {
                    <option value="@lang" selected="@(lang == Model.SelectedLanguage)">@lang</option>
                }
            </select>
        </div>

        <div class="gulla-page">
            <h1 class="gulla-page__title">Graph Optimization</h1>
            <p class="gulla-page__lead">
                Apply search optimization features to finetune search on your websites,
                helping visitors find what they are looking for.
            </p>

            <nav class="gulla-tabs" role="tablist">
                <button type="button" class="gulla-tab" data-tab="pinned-results" role="tab">Pinned Results</button>
                <button type="button" class="gulla-tab" data-tab="synonyms" role="tab">Synonyms</button>
            </nav>

            <section id="gulla-tab-pinned-results" class="gulla-tab-panel" role="tabpanel">
                @await Html.PartialAsync("_PinnedResults")
            </section>

            <section id="gulla-tab-synonyms" class="gulla-tab-panel" role="tabpanel" hidden>
                @await Html.PartialAsync("_Synonyms")
            </section>
        </div>
    </platform-navigation-wrapper>

    <script>
        window.gullaGraphUi = {
            initialTab: '@Html.Raw(Model.ActiveTab)'
        };
    </script>
    <script src="@assets/graph-cms-ui.js"></script>
    <required-client-resources area="@RenderingTags.Footer" />
</body>
</html>
